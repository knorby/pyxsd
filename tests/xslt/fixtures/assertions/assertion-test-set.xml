<test-set xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          xmlns:xs="http://www.w3.org/2001/XMLSchema"
          name="assertion">
   <test-case name="namespace-001">
      <description>Test-set and assertion-local namespace declarations reach XPath assertions.</description>
      <test>
         <stylesheet file="namespace-001.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>xs:integer('1') = 1</assert>
            <assert xmlns:local="http://www.w3.org/2001/XMLSchema">local:integer('2') = 2</assert>
         </all-of>
      </result>
   </test-case>
   <test-case name="message-001">
      <description>A message's content is a document node an assertion can inspect.</description>
      <test>
         <stylesheet file="message-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert-xml><![CDATA[<out/>]]></assert-xml>
            <assert-message>
               <assert>/smart = 'Smart element'</assert>
            </assert-message>
            <assert-message>
               <assert-xml><![CDATA[<smart>Smart element</smart>]]></assert-xml>
            </assert-message>
            <assert-message>
               <assert>/comment() = 'Chicken legs'</assert>
            </assert-message>
            <assert-message>
               <assert-string-value>plain text</assert-string-value>
            </assert-message>
         </all-of>
      </result>
   </test-case>
</test-set>

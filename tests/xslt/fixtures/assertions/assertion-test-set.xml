<test-set xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          xmlns:xs="http://www.w3.org/2001/XMLSchema"
          name="assertion">
   <test-case name="namespace-001">
      <description>Test-set and assertion-local namespace declarations reach XPath assertions.</description>
      <test>
         <stylesheet file="namespace-001.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>xs:integer('1') = 1</assert>
            <assert xmlns:local="http://www.w3.org/2001/XMLSchema">local:integer('2') = 2</assert>
         </all-of>
      </result>
   </test-case>
</test-set>

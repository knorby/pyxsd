<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="urn:example:annotation"
         a:note="root"
         xml:lang="en">
  <a:documentation>Top</a:documentation>
  <start>
    <element name="doc" a:mark="yes">
      <annotation>
        <a:payload>inner</a:payload>
        <define name="not-a-definition"><empty/></define>
        <bogus/>
      </annotation>
      <empty/>
      <a:aside>after</a:aside>
    </element>
  </start>
</grammar>

<grammar xmlns="http://relaxng.org/ns/structure/1.0">
  <start><ref name="node"/></start>
  <define name="node">
    <element name="node">
      <optional>
        <attribute name="name">
          <data type="string"
                datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"/>
        </attribute>
      </optional>
      <zeroOrMore><ref name="node"/></zeroOrMore>
    </element>
  </define>
</grammar>
